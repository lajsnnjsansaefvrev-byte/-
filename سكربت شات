-- ذاكرة محلية لمنع تكرار الرسائل
local displayedMessages = {}

-- وظيفة إضافة الرسائل مع التثبيت على خط Arial لإنهاء علامات الاستفهام
local function appendMessage(senderName, messageText)
    local msgKey = senderName .. ":" .. messageText
    if displayedMessages[msgKey] then return end
    displayedMessages[msgKey] = true

    local MessageLabel = Instance.new("TextLabel")
    MessageLabel.Parent = ChatContainer
    MessageLabel.BackgroundTransparency = 1
    MessageLabel.Font = Enum.Font.ArialBold -- استخدام Arial لدعم الكامل للحروف العربية
    MessageLabel.TextSize = 14
    MessageLabel.TextWrapped = true 
    MessageLabel.TextXAlignment = Enum.TextXAlignment.Right 
    
    MessageLabel.TextStrokeTransparency = 0.5
    MessageLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)

    -- صياغة النص الموحد الصحيح
    if senderName == "vsgtxh0" then
        MessageLabel.Text = messageText .. " :[👑 الادمن] " .. senderName
        MessageLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
    elseif senderName == "System" then
        MessageLabel.Text = messageText .. " :[⚙️]"
        MessageLabel.TextColor3 = Color3.fromRGB(180, 100, 255)
    else
        MessageLabel.Text = messageText .. " :" .. senderName
        MessageLabel.TextColor3 = (senderName == LocalPlayer.Name) and Color3.fromRGB(255, 235, 50) or Color3.fromRGB(255, 255, 255)
    end
    
    -- حساب مساحة النص الآمنة لمنع اختفاء الأسطر
    local textHeight = game:GetService("TextService"):GetTextSize(
        MessageLabel.Text, 
        MessageLabel.TextSize, 
        MessageLabel.Font, 
        Vector2.new(ChatContainer.AbsoluteSize.X - 20, math.huge)
    ).Y
    
    MessageLabel.Size = UDim2.new(1, -10, 0, textHeight + 6)
    
    -- تحريك السكرول لأسفل عند استلام الرسائل الفعلية فقط
    ChatContainer.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y + 10)
    ChatContainer.CanvasPosition = Vector2.new(0, UIListLayout.AbsoluteContentSize.Y)
end

-- جلب الرسائل العالمية
local function getGlobalMessages()
    pcall(function()
        local response = game:HttpGet("https://githubusercontent.com")
        local data = HttpService:JSONDecode(response)
        if data and data.messages then
            for _, msg in ipairs(data.messages) do
                appendMessage(msg.username, msg.text)
            end
        end
    end)
end

-- وظيفة إرسال الرسائل
local function broadcastMessage()
    local text = TextBox.Text
    if text == "" then return end
    
    appendMessage(LocalPlayer.Name, text)
    
    task.spawn(function()
        pcall(function()
            local prefix = (LocalPlayer.Name == "vsgtxh0") and "[👑 الادمن] " or ""
            local payload = HttpService:JSONEncode({
                content = prefix .. "**" .. LocalPlayer.Name .. "** عبر روبلوكس يقول: " .. text
            })
            game:HttpPost("https://discord.com", payload)
        end)
    end)
    
    TextBox.Text = ""
end

-- الترحيب المخصص
appendMessage("System", "هلا منور السكربت")

-- حلقة جلب الرسائل
task.spawn(function()
    while task.wait(4) do
        getGlobalMessages()
    end
end)

-- ربط الأزرار
SendButton.MouseButton1Click:Connect(broadcastMessage)
