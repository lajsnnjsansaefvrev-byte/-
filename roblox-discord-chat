const express = require('express');
const { Client, GatewayIntentBits } = require('discord.js');
const app = express();
const PORT = process.env.PORT || 8000;

app.use(express.json());

// إعداد كود خادم ديسكورد وبوت الاستقبال
const client = new Client({ intents: [GatewayIntentBits.Guilds, GatewayIntentBits.GuildMessages, GatewayIntentBits.MessageContent] });
let robloxMessages = []; // مصفوفة مؤقتة لحفظ الرسائل القادمة من روبلوكس

// 1. نقطة استقبال رسائل روبلوكس لعرضها في الديسكورد وفي السيرفرات الأخرى
app.post('/send-message', (req, res) => {
    const { sender, text } = req.body;
    if (!sender || !text) return res.status(400).json({ error: "Missing data" });

    const formattedMessage = { sender, text, time: Date.now() };
    robloxMessages.push(formattedMessage);
    
    // تنظيف الرسائل القديمة لحفظ الذاكرة
    if (robloxMessages.length > 100) robloxMessages.shift();

    console.log(`[روبلوكس] ${sender}: ${text}`);
    res.json({ success: true });
});

// 2. نقطة فحص السيرفرات الأخرى لروبلوكس لجلب الرسائل الجديدة (الشات العالمي المتبادل)
app.get('/get-messages', (req, res) => {
    res.json(robloxMessages);
});

// تشغيل السيرفر على Koyeb بنجاح
app.listen(PORT, () => {
    console.log(`السيرفر يعمل الآن بنجاح على المنفذ: ${PORT}`);
});

// تسجيل دخول البوت (اختياري لاحقاً إذا أردت الاستقبال العكسي من ديسكورد)
if (process.env.DISCORD_TOKEN) {
    client.login(process.env.DISCORD_TOKEN).catch(console.error);
}
