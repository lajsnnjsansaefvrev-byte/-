local displayedMessages = {}
local lastSendTime = 0
local COOLDOWN_TIME = 2 -- وقت الانتظار بالثواني بين كل رسالة لحماية الويب هوك

-- وظيفة إضافة الرسائل للشات
local function appendMessage(senderName, messageText)
    local msgKey = senderName .. ":" .. messageText
    if displayedMessages[msgKey] then return end
    displayedMessages[msgKey] = true

    local MessageLabel = Instance.new("TextLabel")
    MessageLabel.Parent = ChatContainer
    MessageLabel.BackgroundTransparency = 1
    MessageLabel.Font = Enum.Font.ArialBold
    MessageLabel.TextSize = 14
    MessageLabel.TextWrapped = true
    MessageLabel.TextXAlignment = Enum.TextXAlignment.Left
    MessageLabel.TextStrokeTransparency = 0.5
    MessageLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    
    -- تفعيل RichText لدعم اللغة العربية وتنسيقات الألوان المتقدمة بنجاح
    MessageLabel.RichText = true 
    -- جعل العنصر يتمدد رأسياً تلقائياً بناءً على حجم وطول النص المكتوب
    MessageLabel.AutomaticSize = Enum.AutomaticSize.Y 
    MessageLabel.Size = UDim2.new(1, -10, 0, 0)

    if senderName == "vsgtxh0" then
        MessageLabel.Text = "<font color='rgb(255, 215, 0)'>" .. senderName .. " [الادمن 👑]: </font>" .. messageText
    elseif senderName == "System" then
        MessageLabel.Text = "<font color='rgb(180, 100, 255)'>[⚙️] " .. messageText .. "</font>"
    else
        local nameColor = (senderName == LocalPlayer.Name) and "rgb(255, 235, 50)" or "rgb(255, 255, 255)"
        MessageLabel.Text = "<font color='" .. nameColor .. "'>" .. senderName .. ": </font>" .. messageText
    end
end

-- وظيفة إرسال الرسائل عبر الويب هوك
local function broadcastMessage()
    local text = TextBox.Text
    if text == "" then return end

    -- التحقق من نظام منع السبام (Cooldown) وحماية سيرفر الديسكورد
    local currentTime = os.time()
    if currentTime - lastSendTime < COOLDOWN_TIME then
        appendMessage("System", "برجاء الانتظار قليلاً قبل إرسال الرسالة القادمة!")
        return
    end
    
    lastSendTime = currentTime
    appendMessage(LocalPlayer.Name, text)
    TextBox.Text = ""

    task.spawn(function()
        if requestFunction then
            local prefix = (LocalPlayer.Name == "vsgtxh0") and "[الادمن 👑] " or ""
            local fullContent = prefix .. "**" .. LocalPlayer.Name .. "** عبر روبلوكس يقول: " .. text
            
            fullContent = fullContent:gsub('"', '\\"'):gsub('\n', ' ')

            local payload = '{"content": "' .. fullContent .. '"}'

            local success, err = pcall(function()
                requestFunction({
                    Url = DISCORD_WEBHOOK_URL,
                    Method = "POST",
                    Headers = {
                        ["Content-Type"] = "application/json"
                    },
                    Body = payload
                })
            end)
            
            if not success then
                appendMessage("System", "فشل إرسال الطلب، تأكد من صحة رابط الويب هوك.")
            end
        else
            appendMessage("System", "خطأ: المحاكي (Executor) الحالي لا يدعم طلبات الـ HTTP.")
        end
    end)
end

