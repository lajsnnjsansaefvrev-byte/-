local displayedMessages = {}

local function appendMessage(senderName, messageText)
    local msgKey = senderName .. ":" .. messageText
    if displayedMessages[msgKey] then return end
    displayedMessages[msgKey] = true

    local MessageLabel = Instance.new("TextLabel")
    MessageLabel.Parent = ChatContainer
    MessageLabel.BackgroundTransparency = 1
    MessageLabel.Font = Enum.Font.ArialBold
    MessageLabel.TextSize = 14
    MessageLabel.TextWrapped = true
    MessageLabel.TextXAlignment = Enum.TextXAlignment.Left
    MessageLabel.TextStrokeTransparency = 0.5
    MessageLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    MessageLabel.RichText = true 
    MessageLabel.AutomaticSize = Enum.AutomaticSize.Y 
    MessageLabel.Size = UDim2.new(1, -10, 0, 0)

    if senderName == "vsgtxh0" then
        MessageLabel.Text = "<font color='rgb(255, 215, 0)'>" .. senderName .. " [الادمن 👑]: </font>" .. messageText
    elseif senderName == "System" then
        MessageLabel.Text = "<font color='rgb(180, 100, 255)'>[⚙️] " .. messageText .. "</font>"
    else
        local nameColor = (senderName == LocalPlayer.Name) and "rgb(255, 235, 50)" or "rgb(255, 255, 255)"
        MessageLabel.Text = "<font color='" .. nameColor .. "'>" .. senderName .. ": </font>" .. messageText
    end
end

-- إرسال الرسالة إلى Appwrite
local function sendMessageToCloud(text)
    if not requestFunction then 
        appendMessage("System", "خطأ: المحاكي لا يدعم طلبات HTTP")
        return 
    end

    local payload = HttpService:JSONEncode({
        documentId = "unique()",
        data = {
            sender = LocalPlayer.Name,
            ghat = text
        }
    })

    task.spawn(function()
        local success, res = pcall(function()
            return requestFunction({
                Url = APPWRITE_URL,
                Method = "POST",
                Headers = {
                    ["Content-Type"] = "application/json",
                    ["X-Appwrite-Project"] = APPWRITE_PROJECT_ID
                },
                Body = payload
            })
        end)

        if not success or (res and res.StatusCode and res.StatusCode >= 400) then
            appendMessage("System", "فشل الإرسال! كود الخطأ: " .. tostring(res and res.StatusCode or "Network Error"))
        end
    end)
end

-- جلب الرسائل من السحابة
local function fetchGlobalMessages()
    if not requestFunction then return end

    local success, response = pcall(function()
        return requestFunction({
            Url = APPWRITE_URL .. "?queries[]=limit(20)&queries[]=orderDesc(\"$createdAt\")",
            Method = "GET",
            Headers = {
                ["Content-Type"] = "application/json",
                ["X-Appwrite-Project"] = APPWRITE_PROJECT_ID
            }
        })
    end)

    if success and response and response.Body then
        local ok, data = pcall(function() return HttpService:JSONDecode(response.Body) end)
        if ok and data and data.documents then
            for i = #data.documents, 1, -1 do
                local doc = data.documents[i]
                if doc.sender and doc.ghat then
                    appendMessage(doc.sender, doc.ghat)
                end
            end
        else
            if response.StatusCode and response.StatusCode >= 400 then
                appendMessage("System", "خطأ جلب البيانات: " .. tostring(response.StatusCode))
            end
        end
    end
end

